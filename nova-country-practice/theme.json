{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "780px", "wideSize": "1180px" },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "paper",    "color": "#FBF7F3", "name": "Warm white" },
        { "slug": "mist",     "color": "#F4EDE5", "name": "Beige" },
        { "slug": "blush",    "color": "#F8EFE9", "name": "Blush" },
        { "slug": "stone",    "color": "#E9E0D5", "name": "Soft taupe" },
        { "slug": "greige",   "color": "#D9CCBD", "name": "Greige" },
        { "slug": "deep",     "color": "#26251F", "name": "Charcoal" },
        { "slug": "ink",      "color": "#1A1C17", "name": "Ink" },
        { "slug": "muted",    "color": "#78706A", "name": "Warm grey" },
        { "slug": "clay",     "color": "#8F6249", "name": "Rose brown" },
        { "slug": "sun",      "color": "#CDA790", "name": "Sun" },
        { "slug": "alert",    "color": "#A32C22", "name": "Alert red" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Newsreader",
          "fontFamily": "Newsreader, Georgia, 'Times New Roman', serif",
          "fontFace": [
            { "fontFamily": "Newsreader", "fontWeight": "200", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/Newsreader-200-normal.woff2"] },
            { "fontFamily": "Newsreader", "fontWeight": "300", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/Newsreader-300-normal.woff2"] },
            { "fontFamily": "Newsreader", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/Newsreader-400-normal.woff2"] },
            { "fontFamily": "Newsreader", "fontWeight": "300", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./assets/fonts/Newsreader-300-italic.woff2"] }
          ]
        },
        {
          "slug": "body",
          "name": "Instrument Sans",
          "fontFamily": "'Instrument Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif",
          "fontFace": [
            { "fontFamily": "Instrument Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/InstrumentSans-400-normal.woff2"] },
            { "fontFamily": "Instrument Sans", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/InstrumentSans-500-normal.woff2"] },
            { "fontFamily": "Instrument Sans", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/InstrumentSans-600-normal.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small",   "name": "Small",   "size": "0.85rem" },
        { "slug": "medium",  "name": "Medium",  "size": "1rem" },
        { "slug": "large",   "name": "Large",   "size": "1.35rem",
          "fluid": { "min": "1.2rem", "max": "1.5rem" } },
        { "slug": "x-large", "name": "Heading", "size": "2.5rem",
          "fluid": { "min": "1.75rem", "max": "2.5rem" } },
        { "slug": "xx-large","name": "Display", "size": "4.1rem",
          "fluid": { "min": "2.5rem", "max": "4.1rem" } }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "1", "size": "0.75rem" },
        { "slug": "30", "name": "2", "size": "1.5rem" },
        { "slug": "40", "name": "3", "size": "2.5rem" },
        { "slug": "50", "name": "4", "size": "4rem" },
        { "slug": "60", "name": "5", "size": "6rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "16.5px",
      "lineHeight": "1.62"
    },
    "spacing": { "padding": { "left": "1.25rem", "right": "1.25rem" } },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--ink)" } },
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontSize": "var(--wp--preset--font-size--xx-large)" }, "color": { "text": "var(--wp--preset--color--deep)" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "300", "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontSize": "var(--wp--preset--font-size--x-large)" }, "color": { "text": "var(--wp--preset--color--deep)" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.25", "fontSize": "1.22rem" }, "color": { "text": "var(--wp--preset--color--deep)" } },
      "h4": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "fontSize": "1rem" }, "color": { "text": "var(--wp--preset--color--deep)" } },
      "button": {
        "typography": { "fontSize": "0.83rem", "fontWeight": "500" },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "0.58rem", "bottom": "0.58rem", "left": "1.15rem", "right": "1.15rem" } },
        "color": { "background": "var(--wp--preset--color--deep)", "text": "#F6F4EF" },
        ":hover": { "color": { "background": "#35332B", "text": "#F6F4EF" } }
      }
    },
    "blocks": {
      "core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-wide", "title": "Full width page", "postTypes": ["page"] }
  ]
}
